# SupportFlow RAG local configuration

APP_ENV=local-demo
DATA_DIR=/app/data
SAMPLE_DOCS_DIR=/app/sample_docs

# LLM provider: openrouter, ollama, or mock
LLM_PROVIDER=mock

# OpenRouter mode
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Ollama local mode
OLLAMA_BASE_URL=http://host.docker.internal:11434
# Low-memory local Google model used for native demo mode: gemma3:1b
OLLAMA_MODEL=

# Retrieval
TOP_K=5
VECTOR_WEIGHT=0.6
KEYWORD_WEIGHT=0.4
MIN_ANSWER_SCORE=0.18

# Frontend
BACKEND_PORT=8000
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8000/api
